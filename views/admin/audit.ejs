<%- include('../partials/top') %>
<section class="wrap pad">
  <h1>Audit log</h1>
  <%- include('_nav') %>
  <table class="table small"><thead><tr><th>Time (UTC)</th><th>Actor</th><th>Action</th><th>Entity</th><th>Details</th></tr></thead><tbody>
  <% rows.forEach(function(a){ %><tr><td><%= new Date(a.created_at).toISOString().replace('T',' ').slice(0,19) %></td><td><%= a.actor || '—' %></td><td><%= a.action %></td><td><%= a.entity %> <%= a.entity_id %></td><td class="mono"><%= JSON.stringify(a.details) %></td></tr><% }) %>
  </tbody></table>
</section>
<%- include('../partials/bottom') %>
