<%- include('../partials/top') %>
<section class="wrap pad">
  <h1>Locations</h1>
  <%- include('_nav') %>
  <p class="muted">States, UTs, districts and sub-divisions are stored in the database — changes here appear in every form immediately, without code changes. Verify changes against the <a href="https://lgdirectory.gov.in" rel="noopener">Local Government Directory</a>.</p>
  <table class="table">
    <thead><tr><th>Code</th><th>Name</th><th>Type</th><th>Districts</th><th>Active</th></tr></thead>
    <tbody><% states.forEach(function(s){ %><tr><td><%= s.code %></td><td><a href="/admin/locations/<%= s.code %>"><%= s.name %></a></td><td><%= s.type %></td><td><%= s.districts %></td><td><%= s.active ? 'yes' : 'no' %></td></tr><% }) %></tbody>
  </table>
  <% if (user.role === 'admin') { %>
  <form method="post" action="/admin/locations/states" class="card form inline-form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <h2>Add or rename a state / UT</h2>
    <label>Code<input name="code" maxlength="4" required></label>
    <label>Name<input name="name" required></label>
    <label>Type<select name="type"><option value="state">State</option><option value="ut">Union Territory</option></select></label>
    <button class="btn">Save</button>
  </form>
  <% } %>
</section>
<%- include('../partials/bottom') %>
