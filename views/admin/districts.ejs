<%- include('../partials/top') %>
<section class="wrap pad">
  <h1><%= st.name %> <small class="muted">(<%= st.code %>)</small></h1>
  <%- include('_nav') %>
  <% if (user.role === 'admin') { %>
  <div class="grid2">
    <form method="post" action="/admin/locations/<%= st.code %>/state" class="card form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <h2>State details</h2>
      <label>Name<input name="name" value="<%= st.name %>"></label>
      <label class="check"><input type="checkbox" name="active" <%= st.active?'checked':'' %>> Active</label>
      <button class="btn btn-sm">Save</button>
    </form>
    <form method="post" action="/admin/locations/<%= st.code %>/districts" class="card form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <h2>Add districts</h2>
      <label>One name per line<textarea name="names" rows="4"></textarea></label>
      <button class="btn btn-sm">Add</button>
    </form>
  </div>
  <% } %>
  <table class="table">
    <thead><tr><th>District</th><th>Sub-divisions</th><th>Active</th><% if (user.role==='admin') { %><th>Edit</th><% } %></tr></thead>
    <tbody>
    <% districts.forEach(function(d){ %>
      <tr>
        <td><%= d.name %></td><td><%= d.subs %></td><td><%= d.active?'yes':'no' %></td>
        <% if (user.role==='admin') { %><td>
          <details><summary>edit</summary>
            <form method="post" action="/admin/districts/<%= d.id %>" class="form">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <label>Name<input name="name" value="<%= d.name %>"></label>
              <label class="check"><input type="checkbox" name="active" <%= d.active?'checked':'' %>> Active</label>
              <label>Add sub-divisions (one per line)<textarea name="subdivisions" rows="2"></textarea></label>
              <label>Type<select name="kind"><option>block</option><option>tehsil</option><option>taluk</option><option>mandal</option><option>subdivision</option><option>ward</option></select></label>
              <button class="btn btn-sm">Save</button>
            </form>
          </details>
        </td><% } %>
      </tr>
    <% }) %>
    </tbody>
  </table>
</section>
<%- include('../partials/bottom') %>
